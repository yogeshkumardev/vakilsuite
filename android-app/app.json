{
  "expo": {
    "name": "android-app",
    "slug": "android-app",
    "scheme": "vakilsuite",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "allowBackup": false,
      "permissions": [
        "CAMERA",
        "RECORD_AUDIO"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.yogeshwebdev.androidapp"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-dev-client",
      "expo-secure-store",
      "expo-sqlite",
      "expo-sharing",
      "react-native-blob-util",
      [
        "expo-audio",
        {
          "microphonePermission": "Allow VakilSuite to use your microphone for document dictation.",
          "recordAudioAndroid": true,
          "enableBackgroundRecording": false
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "54b96169-0a4c-459f-acd3-4ff567e61699"
      }
    }
  }
}
